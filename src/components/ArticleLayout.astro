---
interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	title: string;
	description: string;
	difficulty?: string;
	headings?: Heading[];
}

const { title, description, difficulty, headings = [] } = Astro.props;

// Match the old manual TOC: sections and subsections, not every h4.
const toc = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
---

{toc.length > 0 && (
	<div class="article-progress" aria-hidden="true">
		<div class="article-progress__bar" data-article-progress></div>
	</div>
)}

<div class:list={['article-layout', { 'has-toc': toc.length > 0 }]}>
	<article class="article-content">
		<header class="article-header">
			{difficulty && <p class="badge">{difficulty}</p>}
			<h1>{title}</h1>
			<p class="lede">{description}</p>
		</header>

		<div class="prose">
			<slot />
		</div>
	</article>

	{toc.length > 0 && (
		<aside class="article-toc">
			<nav aria-label="On this page">
				<p class="article-toc__title">On this page</p>
				<ul>
					{toc.map((heading) => (
						<li class={`depth-${heading.depth}`}>
							<a href={`#${heading.slug}`}>{heading.text}</a>
						</li>
					))}
				</ul>
			</nav>
		</aside>
	)}
</div>

<script>
	const toc = document.querySelector<HTMLElement>('.article-toc');
	const progressEl = document.querySelector<HTMLElement>('.article-progress');
	const progressBar = progressEl?.querySelector<HTMLElement>('[data-article-progress]');
	const header = document.querySelector<HTMLElement>('header');

	const positionProgress = () => {
		if (!progressEl) return;
		if (header) progressEl.style.top = `${header.getBoundingClientRect().height}px`;
		progressEl.classList.add('is-ready');
	};

	const updateProgress = () => {
		if (!progressBar) return;
		const max = document.documentElement.scrollHeight - window.innerHeight;
		const ratio = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
		progressBar.style.transform = `scaleX(${ratio})`;
	};

	if (toc) {
		const entries = [...toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')]
			.map((link) => {
				const heading = document.getElementById(decodeURIComponent(link.hash.slice(1)));
				return heading ? { link, heading } : null;
			})
			.filter((entry): entry is { link: HTMLAnchorElement; heading: HTMLElement } => entry !== null);

		let current: HTMLAnchorElement | null = null;

		const update = () => {
			const offset = (header?.getBoundingClientRect().height ?? 0) + 32;
			let active: HTMLElement | null = null;

			for (const entry of entries) {
				if (entry.heading.getBoundingClientRect().top <= offset) active = entry.heading;
				else break;
			}

			if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
				active = entries.at(-1)?.heading ?? active;
			}

			const next = active ? (entries.find((entry) => entry.heading === active)?.link ?? null) : null;
			if (next !== current) {
				if (current) current.removeAttribute('aria-current');
				if (next) next.setAttribute('aria-current', 'true');
				current = next;
			}

			updateProgress();
		};

		let ticking = false;
		const onScroll = () => {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(() => {
				update();
				ticking = false;
			});
		};

		window.addEventListener('scroll', onScroll, { passive: true });
		window.addEventListener('resize', () => {
			positionProgress();
			update();
		});

		positionProgress();
		update();

		window.addEventListener('load', () => {
			positionProgress();
			update();
		});
	}
</script>

<style>
	.article-progress {
		position: fixed;
		inset-inline: 0;
		top: calc(var(--etj-header-height) + 1px);
		z-index: 49;
		height: 2px;
		visibility: hidden;
		pointer-events: none;
	}

	.article-progress.is-ready {
		visibility: visible;
	}

	.article-progress__bar {
		width: 100%;
		height: 100%;
		background: var(--etj-accent);
		transform: scaleX(0);
		transform-origin: left;
		will-change: transform;
	}

	.article-layout {
		display: grid;
		gap: 2rem;
		align-items: start;
		justify-content: center;
	}

	.article-layout.has-toc {
		grid-template-columns: minmax(0, 52rem) 14rem;
	}

	.article-content {
		min-width: 0;
		max-width: 52rem;
	}

	.article-header {
		margin-bottom: 2rem;
	}

	.badge {
		display: inline-block;
		margin: 0 0 0.5rem;
		padding: 0.1rem 0.5rem;
		border: 1px solid var(--etj-border);
		border-radius: var(--etj-radius-sm);
		color: var(--etj-muted);
		font-size: 0.8rem;
		text-transform: capitalize;
	}

	.prose {
		max-width: 52rem;
	}

	.article-toc {
		position: sticky;
		/* Header token plus its 1px bottom border, matching the TOC's resting offset. */
		top: calc(var(--etj-header-height) + 3rem + 1px);
		font-size: 0.8125rem;
		line-height: 1.25;
	}

	.article-toc__title {
		margin: 0 0 0.5rem;
		color: var(--etj-fg-strong);
		font-size: 0.9rem;
		font-weight: 600;
		letter-spacing: normal;
		text-transform: none;
	}

	.article-toc ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.article-toc li a {
		display: block;
		margin-inline-start: 0.35rem;
		padding: 0.25rem 0.5rem 0.25rem 0.85rem;
		border-inline-start: 1px solid var(--etj-border);
		color: var(--etj-muted);
		font-size: 0.8125rem;
		line-height: 1.25;
		text-decoration: none;
		transition:
			color 150ms ease,
			border-color 150ms ease;
	}

	.article-toc .depth-3 a {
		padding-left: 1.85rem;
	}

	.article-toc li a:hover,
	.article-toc li a:focus-visible {
		border-color: var(--etj-border-strong);
		color: var(--etj-fg-strong);
	}

	.article-toc li a[aria-current='true'] {
		border-color: var(--etj-accent);
		color: var(--etj-accent-hover);
		font-weight: 600;
	}

	@media (max-width: 74rem) {
		.article-layout.has-toc {
			grid-template-columns: minmax(0, 1fr);
		}

		.article-toc {
			display: none;
		}
	}
</style>
