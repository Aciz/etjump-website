---
interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	title: string;
	description: string;
	difficulty?: string;
	headings?: Heading[];
}

const { title, description, difficulty, headings = [] } = Astro.props;

// Match the old manual TOC: sections and subsections, not every h4.
const toc = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
---

<div class:list={['article-layout', { 'has-toc': toc.length > 0 }]}>
	<article class="article-content">
		<header class="article-header">
			{difficulty && <p class="badge">{difficulty}</p>}
			<h1>{title}</h1>
			<p class="lede">{description}</p>
		</header>

		<div class="prose">
			<slot />
		</div>
	</article>

	{toc.length > 0 && (
		<aside class="article-toc">
			<nav aria-label="On this page">
				<p class="article-toc__title">On this page</p>
				<ul>
					{toc.map((heading) => (
						<li class={`depth-${heading.depth}`}>
							<a href={`#${heading.slug}`}>{heading.text}</a>
						</li>
					))}
				</ul>
			</nav>
		</aside>
	)}
</div>

<script>
	const toc = document.querySelector<HTMLElement>('.article-toc');

	if (toc) {
		const entries = [...toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')]
			.map((link) => {
				const heading = document.getElementById(decodeURIComponent(link.hash.slice(1)));
				return heading ? { link, heading } : null;
			})
			.filter((entry): entry is { link: HTMLAnchorElement; heading: HTMLElement } => entry !== null);

		let current: HTMLAnchorElement | null = null;

		const update = () => {
			const header = document.querySelector<HTMLElement>('header');
			const offset = (header?.getBoundingClientRect().height ?? 0) + 32;
			let active: HTMLElement | null = null;

			for (const entry of entries) {
				if (entry.heading.getBoundingClientRect().top <= offset) active = entry.heading;
				else break;
			}

			if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
				active = entries.at(-1)?.heading ?? active;
			}

			const next = active ? (entries.find((entry) => entry.heading === active)?.link ?? null) : null;
			if (next === current) return;

			if (current) current.removeAttribute('aria-current');
			if (next) next.setAttribute('aria-current', 'true');
			current = next;
		};

		let ticking = false;
		const onScroll = () => {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(() => {
				update();
				ticking = false;
			});
		};

		window.addEventListener('scroll', onScroll, { passive: true });
		window.addEventListener('resize', update);
		update();
	}
</script>

<style>
	.article-layout {
		display: grid;
		gap: 2rem;
		align-items: start;
		justify-content: center;
	}

	.article-layout.has-toc {
		grid-template-columns: minmax(0, 52rem) 14rem;
	}

	.article-content {
		min-width: 0;
		max-width: 52rem;
	}

	.article-header {
		margin-bottom: 2rem;
	}

	.badge {
		display: inline-block;
		margin: 0 0 0.5rem;
		padding: 0.1rem 0.5rem;
		border: 1px solid var(--etj-border);
		border-radius: var(--etj-radius-sm);
		color: var(--etj-muted);
		font-size: 0.8rem;
		text-transform: capitalize;
	}

	.prose {
		max-width: 52rem;
	}

	.article-toc {
		position: sticky;
		top: calc(var(--etj-header-height) + 1.5rem);
		font-size: 0.8125rem;
		line-height: 1.25;
	}

	.article-toc__title {
		margin: 0 0 0.5rem;
		color: var(--etj-fg-strong);
		font-size: 0.9rem;
		font-weight: 600;
		letter-spacing: normal;
		text-transform: none;
	}

	.article-toc ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.article-toc li a {
		position: relative;
		display: block;
		isolation: isolate;
		margin-inline-start: 0.35rem;
		padding: 0.25rem 0.5rem 0.25rem 0.85rem;
		border-inline-start: 1px solid var(--etj-border);
		border-radius: 0;
		color: var(--etj-muted);
		font-size: 0.8125rem;
		line-height: 1.25;
		text-decoration: none;
		transition:
			color 300ms ease,
			border-color 300ms ease,
			font-weight 300ms ease;
	}

	.article-toc .depth-3 a {
		padding-left: 1.85rem;
	}

	.article-toc li a::before {
		content: '';
		position: absolute;
		left: 0;
		top: 50%;
		width: 0;
		height: 0;
		border-top: 0 solid transparent;
		border-bottom: 0 solid transparent;
		border-left: 0 solid var(--etj-accent);
		transform: translateY(-50%);
		transition: border-width 300ms ease-in-out;
	}

	.article-toc li a[aria-current='true'] {
		display: block;
		width: fit-content;
		border-color: var(--etj-accent);
		color: var(--etj-accent-hover);
		font-weight: 700;
	}

	.article-toc li a[aria-current='true']::before {
		border-top-width: 12px;
		border-bottom-width: 12px;
		border-left-width: 9px;
	}

	.article-toc li a[aria-current='true']::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		border-radius: 0.45rem;
		background: linear-gradient(90deg, color-mix(in srgb, var(--etj-accent) 15%, transparent) 0%, transparent 100%);
		box-shadow: 0 0 8px color-mix(in srgb, var(--etj-accent) 30%, transparent);
	}

	.article-toc li a:not([aria-current='true']):hover,
	.article-toc li a:not([aria-current='true']):focus-visible {
		border-color: transparent;
		color: var(--etj-accent-hover);
		font-weight: 600;
		transition: none;
	}

	.article-toc li a:not([aria-current='true']):hover::after,
	.article-toc li a:not([aria-current='true']):focus-visible::after {
		content: '';
		position: absolute;
		inset-block: 0;
		left: -1px;
		width: 3px;
		border-radius: 0 0.5rem 0.5rem 0;
		background: var(--etj-accent);
	}

	@media (max-width: 74rem) {
		.article-layout.has-toc {
			grid-template-columns: minmax(0, 1fr);
		}

		.article-toc {
			display: none;
		}
	}
</style>
