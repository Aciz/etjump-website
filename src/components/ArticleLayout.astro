---
interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	title: string;
	description: string;
	difficulty?: string;
	headings?: Heading[];
}

const { title, description, difficulty, headings = [] } = Astro.props;

// Match the old manual TOC: sections and subsections, not every h4.
const toc = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
---

{toc.length > 0 && (
	<div class="article-progress" aria-hidden="true">
		<div class="article-progress__bar" data-article-progress></div>
	</div>
)}

<div class:list={['article-layout', { 'has-toc': toc.length > 0 }]}>
	<article class="article-content">
		<header class="article-header">
			{difficulty && <p class="badge">{difficulty}</p>}
			<h1>{title}</h1>
			<p class="lede">{description}</p>
		</header>

		{toc.length > 0 && (
			<details class="article-toc-mobile" data-mobile-toc>
				<summary>
					<span class="article-toc-mobile__label">On this page</span>
					<span class="article-toc-mobile__current" data-toc-current></span>
				</summary>
				<nav aria-label="On this page">
					<ul>
						{toc.map((heading) => (
							<li class={`depth-${heading.depth}`}>
								<a href={`#${heading.slug}`}>{heading.text}</a>
							</li>
						))}
					</ul>
				</nav>
			</details>
		)}

		<div class="prose">
			<slot />
		</div>
	</article>

	{toc.length > 0 && (
		<aside class="article-toc">
			<nav aria-label="On this page">
				<p class="article-toc__title">On this page</p>
				<ul>
					{toc.map((heading) => (
						<li class={`depth-${heading.depth}`}>
							<a href={`#${heading.slug}`}>{heading.text}</a>
						</li>
					))}
				</ul>
			</nav>
		</aside>
	)}
</div>

<script>
	const toc = document.querySelector<HTMLElement>('.article-toc');
	const mobileToc = document.querySelector<HTMLDetailsElement>('.article-toc-mobile');
	const progressEl = document.querySelector<HTMLElement>('.article-progress');
	const progressBar = progressEl?.querySelector<HTMLElement>('[data-article-progress]');
	const header = document.querySelector<HTMLElement>('header');

	const positionProgress = () => {
		if (!progressEl) return;
		if (header) progressEl.style.top = `${header.getBoundingClientRect().height}px`;
		progressEl.classList.add('is-ready');
	};

	const updateProgress = () => {
		if (!progressBar) return;
		const max = document.documentElement.scrollHeight - window.innerHeight;
		const ratio = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
		progressBar.style.transform = `scaleX(${ratio})`;
	};

	if (toc || mobileToc) {
		const links = [
			...document.querySelectorAll<HTMLAnchorElement>('.article-toc a[href^="#"]'),
			...document.querySelectorAll<HTMLAnchorElement>('.article-toc-mobile a[href^="#"]'),
		];

		const entries = new Map<string, { heading: HTMLElement; links: HTMLAnchorElement[] }>();

		for (const link of links) {
			const id = decodeURIComponent(link.hash.slice(1));
			const heading = document.getElementById(id);
			if (!heading) continue;

			const entry = entries.get(id) ?? { heading, links: [] };
			entry.links.push(link);
			entries.set(id, entry);
		}

		const ordered = [...entries.values()];
		const currentLabel = document.querySelector<HTMLElement>('[data-toc-current]');
		let current: HTMLElement | null = null;

		const update = () => {
			const offset = (header?.getBoundingClientRect().height ?? 0) + 32;
			let active: HTMLElement | null = null;

			for (const entry of ordered) {
				if (entry.heading.getBoundingClientRect().top <= offset) active = entry.heading;
				else break;
			}

			if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
				active = ordered.at(-1)?.heading ?? active;
			}

			if (active !== current) {
				for (const entry of ordered) {
					for (const link of entry.links) {
						if (entry.heading === active) link.setAttribute('aria-current', 'true');
						else link.removeAttribute('aria-current');
					}
				}

				if (currentLabel) currentLabel.textContent = active?.textContent ?? '';
				current = active;
			}

			updateProgress();
		};

		if (mobileToc) {
			mobileToc.querySelectorAll('a').forEach((link) => {
				link.addEventListener('click', () => {
					mobileToc.open = false;
				});
			});

			document.addEventListener('click', (event) => {
				if (mobileToc.open && !mobileToc.contains(event.target as Node)) {
					mobileToc.open = false;
				}
			});

			document.addEventListener('keydown', (event) => {
				if (event.key === 'Escape' && mobileToc.open) {
					const hasFocus = mobileToc.contains(document.activeElement);
					mobileToc.open = false;
					if (hasFocus) mobileToc.querySelector('summary')?.focus();
				}
			});
		}

		let ticking = false;
		const onScroll = () => {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(() => {
				update();
				ticking = false;
			});
		};

		window.addEventListener('scroll', onScroll, { passive: true });
		window.addEventListener('resize', () => {
			positionProgress();
			update();
		});

		positionProgress();
		update();

		window.addEventListener('load', () => {
			positionProgress();
			update();
		});
	}
</script>

<style>
	.article-progress {
		position: fixed;
		inset-inline: 0;
		top: calc(var(--etj-header-height) + 1px);
		z-index: 49;
		height: 2px;
		visibility: hidden;
		pointer-events: none;
	}

	.article-progress.is-ready {
		visibility: visible;
	}

	.article-progress__bar {
		width: 100%;
		height: 100%;
		background: var(--etj-accent);
		transform: scaleX(0);
		transform-origin: left;
		will-change: transform;
	}

	.article-toc-mobile {
		display: none;
		position: sticky;
		top: calc(var(--etj-header-height) + 3px);
		z-index: 48;
		margin: 0 0 2rem;
		border: 1px solid var(--etj-border);
		border-radius: var(--etj-radius);
		background: var(--etj-surface);
	}

	.article-toc-mobile summary {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.65rem 0.9rem;
		list-style: none;
		color: var(--etj-fg-strong);
		font-size: 0.9rem;
		font-weight: 600;
		cursor: pointer;
	}

	.article-toc-mobile summary::-webkit-details-marker {
		display: none;
	}

	.article-toc-mobile summary::after {
		content: '';
		flex-shrink: 0;
		width: 0.45rem;
		height: 0.45rem;
		margin-left: auto;
		border-right: 1.5px solid currentColor;
		border-bottom: 1.5px solid currentColor;
		transform: rotate(45deg);
		transition: transform 150ms ease;
	}

	.article-toc-mobile[open] summary::after {
		transform: rotate(-135deg);
	}

	.article-toc-mobile__label {
		flex-shrink: 0;
	}

	.article-toc-mobile__current {
		min-width: 0;
		max-width: 55%;
		overflow: hidden;
		color: var(--etj-muted);
		font-size: 0.82rem;
		font-weight: 400;
		white-space: nowrap;
		text-overflow: ellipsis;
	}

	.article-toc-mobile nav {
		max-height: calc(100dvh - var(--etj-header-height) - 4rem);
		padding: 0 0.9rem 0.75rem;
		border-top: 1px solid var(--etj-border);
		overflow-y: auto;
		overscroll-behavior: contain;
	}

	.article-toc-mobile ul {
		list-style: none;
		margin: 0;
		padding: 0.5rem 0 0;
	}

	.article-toc-mobile li a {
		display: block;
		padding: 0.35rem 0 0.35rem 0.5rem;
		border-left: 2px solid transparent;
		color: var(--etj-muted);
		font-size: 0.9rem;
		text-decoration: none;
	}

	.article-toc-mobile li a:hover {
		color: var(--etj-fg-strong);
	}

	.article-toc-mobile .depth-3 a {
		padding-left: 1.25rem;
	}

	.article-toc-mobile li a[aria-current='true'] {
		border-left-color: var(--etj-accent);
		color: var(--etj-accent-hover);
		font-weight: 600;
	}

	.article-layout {
		display: grid;
		gap: 2rem;
		align-items: start;
		justify-content: center;
	}

	.article-layout.has-toc {
		grid-template-columns: minmax(0, 52rem) 14rem;
	}

	.article-content {
		min-width: 0;
		max-width: 52rem;
	}

	.article-header {
		margin-bottom: 2rem;
	}

	.badge {
		display: inline-block;
		margin: 0 0 0.5rem;
		padding: 0.1rem 0.5rem;
		border: 1px solid var(--etj-border);
		border-radius: var(--etj-radius-sm);
		color: var(--etj-muted);
		font-size: 0.8rem;
		text-transform: capitalize;
	}

	.prose {
		max-width: 52rem;
	}

	.article-toc {
		position: sticky;
		/* Header token plus its 1px bottom border, matching the TOC's resting offset. */
		top: calc(var(--etj-header-height) + 3rem + 1px);
		font-size: 0.8125rem;
		line-height: 1.25;
	}

	.article-toc__title {
		margin: 0 0 0.5rem;
		color: var(--etj-fg-strong);
		font-size: 0.9rem;
		font-weight: 600;
		letter-spacing: normal;
		text-transform: none;
	}

	.article-toc ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.article-toc li a {
		display: block;
		margin-inline-start: 0.35rem;
		padding: 0.25rem 0.5rem 0.25rem 0.85rem;
		border-inline-start: 1px solid var(--etj-border);
		color: var(--etj-muted);
		font-size: 0.8125rem;
		line-height: 1.25;
		text-decoration: none;
		transition:
			color 150ms ease,
			border-color 150ms ease;
	}

	.article-toc .depth-3 a {
		padding-left: 1.85rem;
	}

	.article-toc li a:hover,
	.article-toc li a:focus-visible {
		border-color: var(--etj-border-strong);
		color: var(--etj-fg-strong);
	}

	.article-toc li a[aria-current='true'] {
		border-color: var(--etj-accent);
		color: var(--etj-accent-hover);
		font-weight: 600;
	}

	@media (max-width: 74rem) {
		.article-layout.has-toc {
			grid-template-columns: minmax(0, 1fr);
		}

		.article-toc {
			display: none;
		}

		.article-toc-mobile {
			display: block;
		}
	}
</style>
