---
interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	title: string;
	description: string;
	difficulty?: string;
	headings?: Heading[];
}

const { title, description, difficulty, headings = [] } = Astro.props;

// Match the old manual TOC: sections and subsections, not every h4.
const toc = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
---

<div class:list={['article-layout', { 'has-toc': toc.length > 0 }]}>
	<article class="article-content">
		<header class="article-header">
			{difficulty && <p class="badge">{difficulty}</p>}
			<h1>{title}</h1>
			<p class="lede">{description}</p>
		</header>

		<div class="prose">
			<slot />
		</div>
	</article>

	{toc.length > 0 && (
		<aside class="article-toc">
			<nav aria-label="On this page">
				<p class="article-toc__title">On this page</p>
				<ul>
					{toc.map((heading) => (
						<li class={`depth-${heading.depth}`}>
							<a href={`#${heading.slug}`}>{heading.text}</a>
						</li>
					))}
				</ul>
			</nav>
		</aside>
	)}
</div>

<style>
	.article-layout {
		display: grid;
		gap: 2rem;
		align-items: start;
		justify-content: center;
	}

	.article-layout.has-toc {
		grid-template-columns: minmax(0, 52rem) 14rem;
	}

	.article-content {
		min-width: 0;
		max-width: 52rem;
	}

	.article-header {
		margin-bottom: 2rem;
	}

	.badge {
		display: inline-block;
		margin: 0 0 0.5rem;
		padding: 0.1rem 0.5rem;
		border: 1px solid var(--etj-border);
		border-radius: var(--etj-radius-sm);
		color: var(--etj-muted);
		font-size: 0.8rem;
		text-transform: capitalize;
	}

	.prose {
		max-width: 52rem;
	}

	.article-toc {
		position: sticky;
		top: calc(var(--etj-header-height) + 1.5rem);
		font-size: 0.85rem;
		line-height: 1.5;
	}

	.article-toc__title {
		margin: 0 0 0.5rem;
		color: var(--etj-muted);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.article-toc ul {
		list-style: none;
		margin: 0;
		padding: 0;
		border-left: 1px solid var(--etj-border);
	}

	.article-toc li a {
		display: block;
		margin-left: -1px;
		padding: 0.2rem 0 0.2rem 0.75rem;
		border-left: 1px solid transparent;
		color: var(--etj-muted);
		text-decoration: none;
	}

	.article-toc li a:hover {
		color: var(--etj-fg-strong);
		border-left-color: var(--etj-border-strong);
	}

	.article-toc .depth-3 a {
		padding-left: 1.5rem;
	}

	@media (max-width: 74rem) {
		.article-layout.has-toc {
			grid-template-columns: minmax(0, 1fr);
		}

		.article-toc {
			display: none;
		}
	}
</style>
