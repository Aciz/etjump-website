---
import Icon from './Icon.astro';

interface Props {
	/** Anchor used at every size. Takes precedence over the responsive pair. */
	anchor?: string;
	desktopAnchor?: string;
	mobileAnchor?: string;
	/** Breakpoint (a media query length) at which the desktop anchor is used. */
	breakpoint?: string;
	/** 'align' matches the anchor's right edge; 'outside' sits in the gutter beside it. */
	placement?: 'align' | 'outside';
	/** Gap between the anchor and the button when placement is 'outside'. */
	gap?: number;
}

const {
	anchor,
	desktopAnchor = '',
	mobileAnchor = '',
	breakpoint = '74rem',
	placement = 'align',
	gap = 12,
} = Astro.props;
---

<button
	class="back-to-top"
	type="button"
	aria-label="Back to top"
	title="Back to top"
	data-back-to-top
	data-anchor={anchor}
	data-desktop-anchor={desktopAnchor}
	data-mobile-anchor={mobileAnchor}
	data-breakpoint={breakpoint}
	data-placement={placement}
	data-gap={gap}
>
	<Icon name="arrow" size={18} />
</button>

<script>
	const backToTop = document.querySelector<HTMLButtonElement>('[data-back-to-top]');
	const footer = document.querySelector('footer');

	if (backToTop) {
		const update = () => {
			const single = backToTop.dataset.anchor;
			const desktop = backToTop.dataset.desktopAnchor;
			const mobile = backToTop.dataset.mobileAnchor;
			const breakpoint = backToTop.dataset.breakpoint || '74rem';
			const selector = single || (window.matchMedia(`(min-width: ${breakpoint})`).matches ? desktop : mobile);
			const target = selector ? document.querySelector<HTMLElement>(selector) : null;

			if (target) {
				const viewport = document.documentElement.clientWidth;
				const rect = target.getBoundingClientRect();
				const placement = backToTop.dataset.placement ?? 'align';
				const gap = Number(backToTop.dataset.gap ?? 12);

				let right = viewport - rect.right;

				// Put the button in the gutter beside the content instead of on top of it.
				if (placement === 'outside') {
					const width = backToTop.offsetWidth || 40;
					right = viewport - rect.right - gap - width;
					if (right < gap) right = gap;
				}

				backToTop.style.right = `${Math.max(0, right)}px`;
			}

			if (footer) {
				const footerTop = footer.getBoundingClientRect().top;
				backToTop.style.bottom = footerTop < window.innerHeight ? `${window.innerHeight - footerTop + 24}px` : '';
			}

			backToTop.classList.toggle('is-visible', window.scrollY > 600);
		};

		backToTop.addEventListener('click', () => {
			const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
		});

		window.addEventListener('scroll', update, { passive: true });
		window.addEventListener('resize', update);
		window.addEventListener('load', update);
		update();
	}
</script>

<style>
	.back-to-top {
		position: fixed;
		right: 1rem;
		bottom: 1.5rem;
		z-index: 40;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		padding: 0;
		border: 1px solid var(--etj-border);
		border-radius: var(--etj-radius);
		background: var(--etj-surface);
		color: var(--etj-muted);
		box-shadow: 0 4px 12px rgb(0 0 0 / 0.18);
		cursor: pointer;
		opacity: 0;
		visibility: hidden;
		transform: translateY(0.5rem);
		transition:
			opacity 150ms ease,
			transform 150ms ease,
			visibility 150ms ease;
	}

	.back-to-top.is-visible {
		opacity: 1;
		visibility: visible;
		transform: none;
	}

	.back-to-top:hover {
		border-color: var(--etj-accent);
		color: var(--etj-fg-strong);
	}

	.back-to-top > :global(svg) {
		transform: rotate(-90deg);
	}

	:global(html[data-theme='light']) .back-to-top {
		box-shadow: 0 4px 12px rgb(0 0 0 / 0.08);
	}
</style>
