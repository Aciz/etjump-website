---
import { DISCORD_URL, DOCS_ARCHIVE_URL, GITHUB_URL, SITE_TITLE } from '../consts';
import BrandIcon from './BrandIcon.astro';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header>
	<nav aria-label="Main">
		<a class="brand" href="/">
			{SITE_TITLE}
		</a>

		<div class="links">
			<HeaderLink href="/downloads">Downloads</HeaderLink>
			<HeaderLink href="/news">News</HeaderLink>
			<HeaderLink href="/tutorials">Tutorials</HeaderLink>
			<HeaderLink href="/tools">Tools</HeaderLink>
			<HeaderLink href="/resources">Resources</HeaderLink>
			<a href={DOCS_ARCHIVE_URL}>Documentation</a>
		</div>

		<div class="actions">
			<a class="external" href={GITHUB_URL} aria-label="GitHub" title="GitHub">
				<BrandIcon name="github" />
			</a>
			<a class="external" href={DISCORD_URL} aria-label="Discord" title="Discord">
				<BrandIcon name="discord" />
			</a>
			<ThemeToggle />
		</div>
	</nav>
</header>

<script>
	const header = document.querySelector('header');
	const updateHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);

	updateHeader();
	window.addEventListener('scroll', updateHeader, { passive: true });
</script>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 50;
		min-height: var(--etj-header-height);
		border-bottom: 1px solid var(--etj-border);
		background: var(--etj-surface-2);
		transition: background-color 180ms ease;
	}

	header.is-scrolled {
		background-color: color-mix(in srgb, var(--etj-surface-2) 82%, transparent);
		-webkit-backdrop-filter: blur(10px) saturate(1.1);
		backdrop-filter: blur(10px) saturate(1.1);
	}

	@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
		header.is-scrolled {
			background-color: var(--etj-surface-2);
		}
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem;
		min-height: var(--etj-header-height);
		width: min(100% - 2rem, var(--etj-content-width));
		margin-inline: auto;
		padding-block: 0.5rem;
	}

	.brand {
		font-family: var(--etj-font-display);
		font-weight: var(--etj-display-weight);
		font-stretch: var(--etj-display-stretch);
		letter-spacing: var(--etj-display-tracking);
		font-size: 1.05rem;
		color: var(--etj-fg-strong);
		text-decoration: none;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.15rem;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.85rem;
		margin-inline-start: auto;
	}

	.actions a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border-radius: var(--etj-radius-sm);
		color: var(--etj-muted);
		text-decoration: none;
	}

	.actions a:hover {
		background: var(--etj-surface-hover);
		color: var(--etj-fg-strong);
	}

	:global(.links a) {
		padding: 0.35rem 0.6rem;
		border-radius: var(--etj-radius-sm);
		font-size: 0.9rem;
		color: var(--etj-muted);
		text-decoration: none;
	}

	:global(.links a:hover) {
		background: var(--etj-surface-hover);
		color: var(--etj-fg-strong);
	}

	:global(.links a.active) {
		color: var(--etj-accent-hover);
		background: var(--etj-surface);
	}

	@media (max-width: 640px) {
		nav {
			grid-template-columns: 1fr auto;
			grid-template-areas:
				'brand actions'
				'links links';
			display: grid;
			gap: 0.35rem 1rem;
			padding-block: 0.6rem;
		}

		.brand {
			grid-area: brand;
		}

		.actions {
			grid-area: actions;
			margin-inline-start: 0;
		}

		.links {
			grid-area: links;
			overflow-x: auto;
			flex-wrap: nowrap;
			padding-bottom: 0.15rem;
			scrollbar-width: none;
		}

		.links::-webkit-scrollbar {
			display: none;
		}

		.actions .external {
			display: none;
		}
	}
</style>
