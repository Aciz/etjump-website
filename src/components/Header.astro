---
import { DISCORD_URL, DOCS_ARCHIVE_URL, GITHUB_URL, SITE_TITLE } from '../consts';
import BrandIcon from './BrandIcon.astro';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header>
	<nav aria-label="Main">
		<a class="brand" href="/">
			{SITE_TITLE}
		</a>

		<div class="links" id="site-menu">
			<HeaderLink href="/downloads">Downloads</HeaderLink>
			<HeaderLink href="/news">News</HeaderLink>
			<HeaderLink href="/tutorials">Tutorials</HeaderLink>
			<HeaderLink href="/tools">Tools</HeaderLink>
			<HeaderLink href="/resources">Resources</HeaderLink>
			<a href={DOCS_ARCHIVE_URL}>Documentation</a>
		</div>

		<div class="actions">
			<a class="external" href={GITHUB_URL} aria-label="GitHub" title="GitHub">
				<BrandIcon name="github" />
			</a>
			<a class="external" href={DISCORD_URL} aria-label="Discord" title="Discord">
				<BrandIcon name="discord" />
			</a>
			<ThemeToggle />
			<button
				class="menu-toggle"
				type="button"
				aria-label="Toggle menu"
				aria-expanded="false"
				aria-controls="site-menu"
				data-menu-toggle
			>
				<svg class="menu-icon menu-icon--open" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M4 7h16M4 12h16M4 17h16"></path>
				</svg>
				<svg class="menu-icon menu-icon--close" viewBox="0 0 24 24" aria-hidden="true">
					<path d="m6 6 12 12M18 6 6 18"></path>
				</svg>
			</button>
		</div>
	</nav>
</header>

<script>
	const header = document.querySelector('header');
	const updateHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);

	updateHeader();
	window.addEventListener('scroll', updateHeader, { passive: true });

	const menuToggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
	const menu = document.getElementById('site-menu');

	if (header && menuToggle && menu) {
		const setMenuOpen = (open: boolean) => {
			header.toggleAttribute('data-menu-open', open);
			menuToggle.setAttribute('aria-expanded', String(open));
		};

		menuToggle.addEventListener('click', () => {
			const open = !header.hasAttribute('data-menu-open');
			setMenuOpen(open);
			if (open) menu.querySelector<HTMLAnchorElement>('a')?.focus();
		});

		menu.addEventListener('click', (event) => {
			if ((event.target as Element).closest('a')) setMenuOpen(false);
		});

		document.addEventListener('click', (event) => {
			if (header.hasAttribute('data-menu-open') && !header.contains(event.target as Node)) {
				setMenuOpen(false);
			}
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && header.hasAttribute('data-menu-open')) {
				setMenuOpen(false);
				menuToggle.focus();
			}
		});

		window.addEventListener('resize', () => {
			if (window.matchMedia('(min-width: 50rem)').matches) setMenuOpen(false);
		});
	}
</script>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 50;
		min-height: var(--etj-header-height);
		border-bottom: 1px solid var(--etj-border);
		background: var(--etj-surface-2);
		transition: background-color 180ms ease;
	}

	header.is-scrolled {
		background-color: color-mix(in srgb, var(--etj-surface-2) 82%, transparent);
		-webkit-backdrop-filter: blur(10px) saturate(1.1);
		backdrop-filter: blur(10px) saturate(1.1);
	}

	@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
		header.is-scrolled {
			background-color: var(--etj-surface-2);
		}
	}

	nav {
		position: relative;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem;
		min-height: var(--etj-header-height);
		width: min(100% - 2rem, var(--etj-content-width));
		margin-inline: auto;
		padding-block: 0.5rem;
	}

	.brand {
		font-family: var(--etj-font-display);
		font-weight: var(--etj-display-weight);
		font-stretch: var(--etj-display-stretch);
		letter-spacing: var(--etj-display-tracking);
		font-size: 1.05rem;
		color: var(--etj-fg-strong);
		text-decoration: none;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.15rem;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.85rem;
		margin-inline-start: auto;
	}

	.actions a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border-radius: var(--etj-radius-sm);
		color: var(--etj-muted);
		text-decoration: none;
	}

	.actions a:hover {
		background: var(--etj-surface-hover);
		color: var(--etj-fg-strong);
	}

	.menu-toggle {
		display: none;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		padding: 0;
		border: 1px solid var(--etj-border);
		border-radius: var(--etj-radius);
		background: transparent;
		color: var(--etj-muted);
		cursor: pointer;
	}

	.menu-toggle:hover {
		border-color: var(--etj-accent);
		color: var(--etj-fg-strong);
	}

	.menu-icon {
		width: 1rem;
		height: 1rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
	}

	.menu-icon--close {
		display: none;
	}

	header[data-menu-open] .menu-icon--open {
		display: none;
	}

	header[data-menu-open] .menu-icon--close {
		display: block;
	}

	:global(.links a) {
		padding: 0.35rem 0.6rem;
		border-radius: var(--etj-radius-sm);
		font-size: 0.9rem;
		color: var(--etj-muted);
		text-decoration: none;
	}

	:global(.links a:hover) {
		background: var(--etj-surface-hover);
		color: var(--etj-fg-strong);
	}

	:global(.links a.active) {
		color: var(--etj-accent-hover);
		background: var(--etj-surface);
	}

	@media (max-width: 50rem) {
		nav {
			grid-template-columns: 1fr auto;
			grid-template-areas: 'brand actions';
			display: grid;
			gap: 0.35rem 1rem;
			padding-block: 0.6rem;
		}

		.brand {
			grid-area: brand;
		}

		.actions {
			grid-area: actions;
			margin-inline-start: 0;
		}

		.links {
			display: none;
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			flex-direction: column;
			flex-wrap: nowrap;
			gap: 0.15rem;
			padding: 0.5rem;
			border: 1px solid var(--etj-border);
			border-top: 0;
			border-radius: 0 0 var(--etj-radius) var(--etj-radius);
			background: var(--etj-surface-2);
			box-shadow: 0 10px 24px rgb(0 0 0 / 0.25);
		}

		header[data-menu-open] .links {
			display: flex;
		}

		:global(html[data-theme='light']) .links {
			box-shadow: 0 10px 24px rgb(0 0 0 / 0.12);
		}

		:global(.links a) {
			display: grid;
			width: 100%;
			padding: 0.55rem 0.6rem;
			font-size: 0.95rem;
		}

		.menu-toggle {
			display: inline-flex;
		}
	}
</style>
