---
import Icon from './Icon.astro';

interface Props {
	type?: 'note' | 'tip' | 'caution' | 'danger';
	title?: string;
}

const { type = 'note', title } = Astro.props;

const labels = {
	note: 'Note',
	tip: 'Tip',
	caution: 'Caution',
	danger: 'Danger',
} as const;

const icons = {
	note: 'info',
	tip: 'rocket',
	caution: 'warning',
	danger: 'error',
} as const;

const heading = title ?? labels[type];
---

<aside class:list={['aside', type !== 'note' && type]} aria-label={heading}>
	<p class="aside-title" aria-hidden="true">
		<Icon name={icons[type]} class="aside-icon" size={22} />
		{heading}
	</p>
	<slot />
</aside>
