---
import { WEBSITE_SOURCE_URL } from '../consts';

const year = new Date().getFullYear();
---

<footer>
	<div class="inner">
		<p>&copy; {year} ETJump Team</p>
		<p class="footer-links">
			<a href={WEBSITE_SOURCE_URL}>Website source</a>
			<a href="/rss.xml">RSS</a>
		</p>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--etj-border);
		background: var(--etj-surface-2);
		color: var(--etj-muted);
		font-size: 0.85rem;
	}

	.inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1.5rem;
		justify-content: space-between;
		width: min(100% - 2rem, var(--etj-content-width));
		margin-inline: auto;
		padding-block: 1.25rem;
	}

	footer p {
		margin: 0;
	}

	.footer-links {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}

	footer a {
		color: var(--etj-muted);
		text-decoration: none;
	}

	footer a:hover {
		color: var(--etj-fg-strong);
	}
</style>
