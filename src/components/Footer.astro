---
import BrandIcon from './BrandIcon.astro';
import Icon from './Icon.astro';
import { WEBSITE_SOURCE_URL } from '../consts';

const year = new Date().getFullYear();
---

<footer>
	<div class="inner">
		<p>&copy; {year} ETJump Team</p>
		<ul class="footer-links">
			<li>
				<a href="/rss.xml">
					<Icon name="rss" size={14} />
					RSS
				</a>
			</li>
			<li>
				<a href={WEBSITE_SOURCE_URL}>
					<BrandIcon name="github" size={14} />
					Website source
				</a>
			</li>
		</ul>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--etj-border);
		background: var(--etj-surface-2);
		color: var(--etj-muted);
		font-size: 0.85rem;
	}

	.inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1.5rem;
		justify-content: space-between;
		width: min(100% - 2rem, var(--etj-content-width));
		margin-inline: auto;
		padding-block: 1.25rem;
	}

	footer p {
		margin: 0;
	}

	.footer-links {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.4rem;
		margin: 0;
		padding: 0;
		list-style: none;
		text-align: right;
	}

	footer a {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--etj-muted);
		text-decoration: none;
	}

	footer a:hover {
		color: var(--etj-fg-strong);
	}
</style>
