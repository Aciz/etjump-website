---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import NewsPost from '../../layouts/NewsPost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('news', ({ data }) => !data.draft);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}

type Props = CollectionEntry<'news'>;

const post = Astro.props;
const { Content } = await render(post);

// Rough reading time from the raw body; good enough for a byline.
const words = post.body?.trim().split(/\s+/).length ?? 0;
const readingTime = Math.max(1, Math.round(words / 200));
---

<NewsPost {...post.data} readingTime={readingTime}>
	<Content />
</NewsPost>
