---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Resources" description="Mapping tools, documentation and assets for ETJump.">
	<h1>Resources</h1>
	<p class="lede">Mapping environments, assets and external documentation.</p>

	<div class="card-grid">
		<a class="card" href="https://github.com/etjump/mapping">
			<h3>Mapping environment</h3>
			<p>The ETJump mapping toolchain and configuration.</p>
		</a>
		<a class="card" href="https://etjump.readthedocs.io/">
			<h3>ETJump documentation</h3>
			<p>Entities, cvars and server setup (currently on Read the Docs).</p>
		</a>
		<a class="card" href="https://github.com/id-tech-3-tools/ET-extra-assets">
			<h3>Mapping assets</h3>
			<p>Extra assets for Enemy Territory mapping.</p>
		</a>
		<a class="card" href="https://github.com/id-tech-3-tools/map-compiler">
			<h3>Custom Q3Map2 compiler</h3>
			<p>Patched map compiler for Enemy Territory.</p>
		</a>
		<a class="card" href="https://github.com/id-tech-3-tools/map-compiler/wiki">
			<h3>Q3Map2 documentation</h3>
			<p>Compiler options and behaviour.</p>
		</a>
		<a class="card" href="http://q3map2.robotrenegade.com/docs/shader_manual/">
			<h3>Q3 shader manual</h3>
			<p>Reference for shader scripts.</p>
		</a>
	</div>
</BaseLayout>
