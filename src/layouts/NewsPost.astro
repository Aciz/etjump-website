---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import ArticleProgress from '../components/ArticleProgress.astro';
import BackToTop from '../components/BackToTop.astro';
import ImageLightbox from '../components/ImageLightbox.astro';

type Props = CollectionEntry<'news'>['data'] & { readingTime?: number };

const { title, description, pubDate, updatedDate, heroImage, author, readingTime } = Astro.props;
---

<BaseLayout title={title} description={description}>
	<ArticleProgress />

	<article class="news-post">
		<header class="post-header">
			<p class="kicker">News</p>
			<h1>{title}</h1>
			<p class="lede">{description}</p>

			<div class="byline">
				<span class="author">{author}</span>
				<p class="meta">
					<FormattedDate date={pubDate} />
					{readingTime && <span>· {readingTime} min read</span>}
					{updatedDate && (
						<span>
							· Updated <FormattedDate date={updatedDate} />
						</span>
					)}
				</p>
			</div>
		</header>

		{heroImage && <Image class="hero" width={1020} height={510} src={heroImage} alt="" />}

		<div class="prose">
			<slot />
		</div>
	</article>

	<BackToTop anchor=".news-post" placement="outside" />
	<ImageLightbox />
</BaseLayout>

<style>
	.news-post {
		max-width: 52rem;
	}

	.post-header {
		margin-bottom: 2.25rem;
		padding-bottom: 1.75rem;
		border-bottom: 1px solid var(--etj-border);
	}

	.kicker {
		margin: 0 0 0.5rem;
		color: var(--etj-accent);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	h1 {
		max-width: 24ch;
		margin: 0 0 0.75rem;
		font-size: clamp(2.1rem, 4.5vw, 3rem);
		line-height: 1.08;
	}

	.lede {
		margin: 0;
		color: var(--etj-muted);
		font-size: 1.1rem;
		line-height: 1.6;
	}

	.byline {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		margin-top: 1.5rem;
	}

	.author {
		color: var(--etj-fg-strong);
		font-size: 0.95rem;
		font-weight: 600;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem;
		margin: 0;
		color: var(--etj-muted);
		font-size: 0.82rem;
	}

	.hero {
		display: block;
		width: 100%;
		margin-bottom: 2rem;
		border-radius: var(--etj-radius);
	}

	.news-post :global(.news-figure) {
		width: min(100%, 18rem);
		margin: 2rem auto;
	}

	.news-post :global(.news-figure img) {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid var(--etj-border);
		border-radius: var(--etj-radius);
		box-shadow: 0 6px 18px rgb(0 0 0 / 0.16);
	}

	.news-post :global(.news-figure figcaption) {
		margin-top: 0.6rem;
		color: var(--etj-muted);
		font-size: 0.8rem;
		text-align: center;
	}
</style>
